# Default: normalize text files to LF
* text=auto eol=lf

# Explicitly text files we care about
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.rs   text eol=lf

# Windows scripts (if added later)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
