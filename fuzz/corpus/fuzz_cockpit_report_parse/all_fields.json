{
  "schema": "cockpit.report.v1",
  "tool": { "name": "cockpitctl", "version": "99.99.99" },
  "run": { "started_at": "2026-12-31T23:59:59.999Z" },
  "verdict": {
    "status": "fail",
    "counts": { "info": 100, "warn": 200, "error": 300, "suppressed": 50 },
    "reasons": ["too_many_errors", "missing_sensor", "policy_violation"]
  },
  "sensors": [
    {
      "id": "builddiag",
      "blocking": true,
      "missing": "fail",
      "presence": "present",
      "report_path": "artifacts/builddiag/report.json",
      "comment_path": "artifacts/builddiag/comment.md",
      "verdict": { "status": "fail", "counts": { "info": 50, "warn": 100, "error": 200 }, "reasons": ["compilation_failed"] },
      "truncated": true,
      "errors": ["receipt truncated at 2MB limit"],
      "missing_policy_applied": "fail",
      "policy_outcome": "blocked"
    },
    {
      "id": "diffguard",
      "blocking": false,
      "missing": "skip",
      "presence": "missing",
      "report_path": "artifacts/diffguard/report.json",
      "verdict": { "status": "skip", "counts": { "info": 0, "warn": 0, "error": 0 }, "reasons": ["missing_receipt"] },
      "truncated": false,
      "errors": ["receipt not found"],
      "missing_policy_applied": "skip",
      "policy_outcome": "informational"
    }
  ],
  "highlights": [
    {
      "sensor_id": "builddiag",
      "finding": {
        "severity": "error",
        "check_id": "rustc",
        "code": "E0308",
        "message": "mismatched types",
        "location": { "path": "src/main.rs", "line": 42, "col": 15 },
        "help": "try using .parse::<u32>()",
        "url": "https://doc.rust-lang.org/error-index.html#E0308",
        "fingerprint": "abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890",
        "data": { "expected": "u32", "found": "&str" }
      }
    }
  ],
  "policy": {
    "warn_is_fail": true,
    "max_highlights": 3,
    "max_per_sensor_findings": 10,
    "max_annotations": 5,
    "section_order": ["Highlights", "Diagnostics", "Policy"],
    "sensors": [
      { "id": "builddiag", "blocking": true, "missing": "fail", "section": "Diagnostics", "repro": "builddiag check" },
      { "id": "diffguard", "blocking": false, "missing": "skip" }
    ]
  },
  "data": { "custom_key": "custom_value", "nested": { "deep": true } }
}
